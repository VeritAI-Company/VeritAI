{
  "manifest_version": 3,
  "name": "Deepfake Detector",
  "version": "1.1",
  "description": "Detect deepfake images or video frames on web pages.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "offscreen",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8080/*"
  ],
  "action": {
    "default_popup": "frontend/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "frontend/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "frontend/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
